# API Keys for Data Sources
# Copy this file to .env and fill in your API keys

# FRED API Key (optional but recommended)
# Get free key at: https://research.stlouisfed.org/user/accounts/apikey
FRED_API_KEY=your_fred_api_key_here

# Alpha Vantage API Key (optional, for backup)
# Get free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# IEX Cloud API Key (optional, paid)
# Get key at: https://iexcloud.io/
IEX_API_KEY=your_iex_api_key_here
